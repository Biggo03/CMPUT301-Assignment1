<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RapidRecall">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainMenuScreen"
            android:exported="false"
            android:label="@string/title_activity_main_menu_screen"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GameScreen"
            android:exported="false"
            android:label="@string/title_activity_game_screen"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SummaryScreen"
            android:exported="false"
            android:label="@string/title_activity_summary_screen"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AttemptLogScreen"
            android:exported="false"
            android:label="@string/title_activity_attempt_log_screen"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RapidRecallButton"
            android:exported="false"
            android:label="@string/title_activity_rapid_recall_button"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RapidRecallBackground"
            android:exported="false"
            android:label="@string/title_activity_rapid_recall_background"
            android:theme="@style/Theme.RapidRecall"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>